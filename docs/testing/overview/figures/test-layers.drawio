<mxfile host="drawio" version="24.7.17">
  <!--
    Figure: layer substitution in a host test.
    Used by docker-and-test-guide.tex (fig:stack). Exported to figures/pdf/
    by build-docs.sh. Left: what runs on the satellite. Right: what a suite
    binary links. Blue rows are the same source files on both sides.
  -->
  <diagram id="test-layers" name="Test layers">
    <mxGraphModel dx="1560" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="hl" value="Real firmware (STM32L476RG)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#333333;fontColor=#FFFFFF;strokeColor=none;fontStyle=1;fontSize=15;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="500" height="40" as="geometry" /></mxCell>
        <mxCell id="hr" value="Test executable (PC, inside the pocat-tests container)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#333333;fontColor=#FFFFFF;strokeColor=none;fontStyle=1;fontSize=15;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="780" y="50" width="500" height="40" as="geometry" /></mxCell>
        <mxCell id="l1" value="&lt;b&gt;Entry point&lt;/b&gt;: main.c &amp;rarr; scheduler &amp;rarr; tasks" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;spacing=6;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="500" height="58" as="geometry" /></mxCell>
        <mxCell id="r1" value="&lt;b&gt;Suite&lt;/b&gt; test_&amp;lt;module&amp;gt;.c: main() from pocat_test_main.h + Unity" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;spacing=6;fillColor=#F1F1F1;strokeColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="780" y="110" width="500" height="58" as="geometry" /></mxCell>
        <mxCell id="c1" value="replaced by" style="html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#8A5200;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="l1" target="r1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="l2" value="&lt;b&gt;Production code&lt;/b&gt;: src/subsystems/*/*.c, src/utils/*.c" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;spacing=6;fillColor=#DCE8F4;strokeColor=#1F4E79;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="40" y="188" width="500" height="58" as="geometry" /></mxCell>
        <mxCell id="r2" value="&lt;b&gt;The same .c files&lt;/b&gt;, pulled in with #include &amp;quot;x.c&amp;quot;&lt;br&gt;(so the test can read and reset static state)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;spacing=6;fillColor=#DCE8F4;strokeColor=#1F4E79;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="780" y="188" width="500" height="58" as="geometry" /></mxCell>
        <mxCell id="c2" value="identical" style="html=1;endArrow=none;strokeWidth=4;strokeColor=#1F4E79;fontColor=#1F4E79;fontStyle=1;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="l2" target="r2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="l3" value="&lt;b&gt;Project headers&lt;/b&gt; (include/)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;spacing=6;fillColor=#DCE8F4;strokeColor=#1F4E79;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="40" y="266" width="500" height="58" as="geometry" /></mxCell>
        <mxCell id="r3" value="&lt;b&gt;The same headers&lt;/b&gt; (include/)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;spacing=6;fillColor=#DCE8F4;strokeColor=#1F4E79;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="780" y="266" width="500" height="58" as="geometry" /></mxCell>
        <mxCell id="c3" value="identical" style="html=1;endArrow=none;strokeWidth=4;strokeColor=#1F4E79;fontColor=#1F4E79;fontStyle=1;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="l3" target="r3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="l4" value="&lt;b&gt;FreeRTOS&lt;/b&gt;: scheduler, queues, notifications,&lt;br&gt;event groups, timers" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;spacing=6;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="344" width="500" height="58" as="geometry" /></mxCell>
        <mxCell id="r4" value="&lt;b&gt;stubs_rtos/*.h + fake_rtos.c&lt;/b&gt;: one thread, records every call,&lt;br&gt;simulates blocking, flags deadlocks" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;spacing=6;fillColor=#F0B65E;strokeColor=#8A5200;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="780" y="344" width="500" height="58" as="geometry" /></mxCell>
