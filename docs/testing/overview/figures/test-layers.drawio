        <mxCell id="lg2t" value="real infrastructure" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="372" y="742" width="170" height="24" as="geometry" /></mxCell>
