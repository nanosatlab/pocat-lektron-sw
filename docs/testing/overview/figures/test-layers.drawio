        <mxCell id="l5" value="&lt;b&gt;STM32 HAL + CMSIS&lt;/b&gt;; clocks (clock.c, periph.c)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;spacing=6;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="422" width="500" height="58" as="geometry" /></mxCell>
        <mxCell id="r5" value="&lt;b&gt;stubs_hal/*.h + fake_hal.c&lt;/b&gt;; &lt;b&gt;fake_clock.c&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;spacing=6;fillColor=#F0B65E;strokeColor=#8A5200;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="780" y="422" width="500" height="58" as="geometry" /></mxCell>
        <mxCell id="c5" value="replaced by" style="html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#8A5200;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="l5" target="r5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="l6" value="&lt;b&gt;Flash&lt;/b&gt;: obdh_requests.c &amp;rarr; OBDH task &amp;rarr; flash.c &amp;rarr; 1 MB" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;spacing=6;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="500" height="58" as="geometry" /></mxCell>
        <mxCell id="r6" value="&lt;b&gt;fake_obdh_requests&lt;/b&gt;, &lt;b&gt;fake_flash_driver&lt;/b&gt; or&lt;br&gt;&lt;b&gt;mock_obdh_requests&lt;/b&gt;: the flash lives in RAM" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;spacing=6;fillColor=#F0B65E;strokeColor=#8A5200;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="780" y="500" width="500" height="58" as="geometry" /></mxCell>
        <mxCell id="c6" value="replaced by" style="html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#8A5200;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="l6" target="r6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="l7" value="&lt;b&gt;Radio&lt;/b&gt;: RadioLib + SX1262 (SPI, DIO1), rest of comms" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;spacing=6;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="578" width="500" height="58" as="geometry" /></mxCell>
        <mxCell id="r7" value="&lt;b&gt;fake_link&lt;/b&gt; (programmable link) + &lt;b&gt;fake_comms_env&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;spacing=6;fillColor=#F0B65E;strokeColor=#8A5200;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="780" y="578" width="500" height="58" as="geometry" /></mxCell>
        <mxCell id="c7" value="replaced by" style="html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#8A5200;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="l7" target="r7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="l8" value="Cortex-M4F, 32 bits, real time" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;spacing=6;fillColor=#EBEBEB;strokeColor=#808080;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="656" width="500" height="58" as="geometry" /></mxCell>
        <mxCell id="r8" value="Linux process, x86-64, 64 bits, ASan + UBSan" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;spacing=6;fillColor=#EBEBEB;strokeColor=#808080;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="780" y="656" width="500" height="58" as="geometry" /></mxCell>
        <mxCell id="c8" value="runs on" style="html=1;endArrow=none;strokeWidth=1.2;strokeColor=#808080;dashed=1;fontStyle=2;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="l8" target="r8"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="brace" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;flipH=1;strokeColor=#8A5200;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1290" y="344" width="24" height="292" as="geometry" /></mxCell>
        <mxCell id="incl" value="&lt;b&gt;How the swap happens&lt;/b&gt;&lt;br&gt;The include path puts&lt;br&gt;test/mocks/stubs_rtos/ and&lt;br&gt;test/mocks/stubs_hal/ first,&lt;br&gt;so #include &amp;quot;FreeRTOS.h&amp;quot;&lt;br&gt;finds the test header.&lt;br&gt;The fake .c files implement&lt;br&gt;those prototypes.&lt;br&gt;&lt;br&gt;&lt;b&gt;No #ifdef TEST&lt;/b&gt; anywhere&lt;br&gt;in the flight code." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1322" y="334" width="210" height="312" as="geometry" /></mxCell>
        <mxCell id="lg1" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;spacing=6;fillColor=#DCE8F4;strokeColor=#1F4E79;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="40" y="744" width="34" height="20" as="geometry" /></mxCell>
        <mxCell id="lg1t" value="production code (not touched)" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="82" y="742" width="230" height="24" as="geometry" /></mxCell>
